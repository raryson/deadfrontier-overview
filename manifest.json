{
  "manifest_version": 3,
  "name": "DeadFrontier Overview",
  "version": "0.7.2",
  "description": "__MSG_description__",
  "default_locale": "en",
  "content_security_policy": {"extension_pages":"script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self' data: blob:"},
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fairview-companion@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_title": "DeadFrontier Overview"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fairview.deadfrontier.com/onlinezombiemmo/*"
      ],
      "js": [
        "xp-protocol.js",
        "page-observer.js",
        "bank-request.js",
        "xp-request.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://fairview.deadfrontier.com/onlinezombiemmo/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "dashboard.js",
        "styles.css",
        "core.js",
        "catalog.js",
        "i18n.js",
      "experience.js",
      "capture-controller.js",
      "ocr-parser.js",
      "ocr-environment.js"
      ],
      "matches": [
        "https://fairview.deadfrontier.com/*"
      ]
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
